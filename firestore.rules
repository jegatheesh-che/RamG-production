rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify if the request is from the specific admin UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "Zks20I2RBLdxaa7qIu6jG1kS5CP2";
    }

    // Rules for Gallery Collection
    match /gallery/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Rules for Reviews Collection
    match /reviews/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Rules for About Collection (Section 1 & 2 Content)
    match /about/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deny all other collections by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
